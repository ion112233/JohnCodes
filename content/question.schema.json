{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JohnCodes script (interview question or course episode)",
  "type": "object",
  "required": ["id", "title", "topic", "prompt", "segments"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 48 },
    "topic": { "type": "string", "minLength": 1, "maxLength": 40 },
    "prompt": {
      "type": "string",
      "maxLength": 160,
      "description": "one line: the problem (question) or 'by the end you can…' (episode)"
    },
    "difficulty": { "enum": ["Easy", "Medium", "Hard"], "default": "Easy" },
    "filename": { "type": "string", "default": "solution.py" },

    "complexity": {
      "type": "object",
      "description": "interview questions only — drives the takeaway card",
      "required": ["time", "space"],
      "additionalProperties": false,
      "properties": {
        "time": { "type": "string" },
        "space": { "type": "string" }
      }
    },

    "episode": {
      "type": "object",
      "description": "course episodes only — drives the episode card + progress dots",
      "required": ["number", "of", "series"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "of": { "type": "integer", "minimum": 1 },
        "series": { "type": "string" }
      }
    },
    "targetMinutes": {
      "type": "number",
      "description": "episodes: expected runtime; build warns if actual is off by >8%"
    },

    "thumbnail": {
      "type": "object",
      "description": "optional copy for `python -m johncodes thumbnail`; every field falls back to the script",
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "description": "1-2 short lines separated by \\n, lowercase" },
        "hook": { "type": "string", "maxLength": 48, "description": "one curiosity / payoff line" },
        "snippet": { "type": "string", "description": "3-6 lines of code (<= 32 chars wide)" },
        "question": { "type": "string", "description": "big question for the curiosity layout, \\n for line breaks" },
        "bad": { "type": "string", "description": "short code shown with a result strip under it" },
        "result": { "type": "string", "maxLength": 56, "description": "the error / output line under `bad`" },
        "resultOk": { "type": "boolean", "default": false, "description": "result is a success (green) instead of an error (red)" }
      }
    },

    "segments": {
      "type": "array",
      "minItems": 1,
      "description": "ordered blocks. Episode beat pattern: card_episode(auto) -> per topic { card_topic, narration+code, terminal/repl, gotcha/compare, card_question } -> card_recap",
      "items": { "$ref": "#/definitions/segment" }
    }
  },

  "definitions": {
    "segment": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["narration", "code", "terminal", "repl", "gotcha", "compare",
                   "card_topic", "card_question", "card_recap"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "narration" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": true,
              "text": { "type": "string", "description": "spoken narration, sent to TTS" },
              "beat": {
                "enum": ["hook", "walkthrough", "takeaway"],
                "description": "hook: over the opener card; walkthrough: while the next code types; takeaway: over the closer. No beat = voices the segment that follows."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "code" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "code"],
            "properties": {
              "type": true,
              "code": {
                "type": "string",
                "description": "full file at this point; the editor keeps the common prefix with the previous code segment and types the rest. Lines <= 42 chars, 4-space indent."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "terminal" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "command", "output"],
            "properties": {
              "type": true,
              "command": { "type": "string" },
              "output": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "repl" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "lines"],
            "properties": {
              "type": true,
              "lines": {
                "type": "array",
                "minItems": 1,
                "description": "interactive >>> session: each input types out, then its output appears",
                "items": {
                  "type": "object",
                  "required": ["input"],
                  "additionalProperties": false,
                  "properties": {
                    "input": { "type": "string" },
                    "output": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "gotcha" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "code", "error"],
            "properties": {
              "type": true,
              "code": { "type": "string", "description": "the broken code shown in the editor" },
              "badLine": { "type": "integer", "description": "1-based line to mark with a red squiggle" },
              "error": { "type": "string", "description": "the traceback / error text shown in the Run panel" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "compare" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "left", "right"],
            "properties": {
              "type": true,
              "left": { "type": "string" },
              "leftLabel": { "type": "string", "maxLength": 28 },
              "right": { "type": "string" },
              "rightLabel": { "type": "string", "maxLength": 28 },
              "verdict": { "type": "string", "maxLength": 120 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "card_topic" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "cardTitle"],
            "properties": {
              "type": true,
              "cardTitle": { "type": "string", "maxLength": 40 },
              "cardSubtitle": { "type": "string", "maxLength": 80 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "card_question" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "question"],
            "properties": {
              "type": true,
              "question": { "type": "string", "maxLength": 120 },
              "answer": { "type": "string", "maxLength": 120 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "card_recap" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "points"],
            "properties": {
              "type": true,
              "points": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": { "type": "string", "maxLength": 90 }
              },
              "next": { "type": "string", "maxLength": 60, "description": "teaser for the next episode" }
            }
          }
        }
      ]
    }
  }
}
